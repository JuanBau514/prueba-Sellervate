# Start the local stack, then copy its credentials from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Reserved for scripts/seed.ts; never import into src/.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Shared password of the local demo accounts created by the seed.
DEMO_PASSWORD=sellervate-demo
